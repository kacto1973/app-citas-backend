# 🔧 CONFIGURACIÓN PARA DESARROLLO
# Copia este archivo como .env.local y rellena con TUS datos

# Firebase Admin SDK
FIREBASE_PROJECT_ID=tu_project_id_aqui
FIREBASE_PRIVATE_KEY_ID=tu_private_key_id_aqui
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_llave_privada_aqui\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=tu_email@proyecto.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=1234567890
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...
FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com

# App Config
NODE_ENV=development or production
ALLOWED_ORIGINS=http://localhost:3000,https://tu-frontend.vercel.app
EOF

# MercadoPago (si usas) aquí van CREDENCIALES DE PRUEBA 
MP_ACCESS_TOKEN=TU_ACCESS_TOKEN_DE_MERCADO_PAGO_AQUI